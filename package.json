{
  "name": "pvl-hub",
  "version": "1.0.0",
  "description": "PVL Hub — Premier Volleyball League fan platform (web + iOS)",
  "private": true,
  "scripts": {
    "dev": "netlify dev",
    "build": "echo 'Static site - nothing to build'",
    "art": "python3 scripts/make-app-art.py",
    "build:www": "node scripts/build-www.js",
    "cap:sync": "npm run build:www && npx cap sync ios && npm run art",
    "cap:copy": "npm run build:www && npx cap copy ios",
    "cap:open": "npx cap open ios",
    "cap:run": "npm run cap:sync && npx cap run ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4"
  },
  "capacitor": {
    "appId": "com.globallyballin.pvlhub",
    "appName": "PVL Hub",
    "webDir": "www"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
